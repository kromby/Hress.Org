{
  "name": "ez.hress.reactweb",
  "version": "2.6.3",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "dbuild": "react-app-rewired build",
    "build": "react-app-rewired build && npm run sentry:sourcemaps && npm run sentry:sourcemaps",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "version": "",
    "postversion": "git push && git push --tags",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ez-group --project hressorg-web ./build && sentry-cli sourcemaps upload --org ez-group --project hressorg-web ./build"
  },
  "dependencies": {
    "@sentry/cli": "^3.6.2",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/react-star-ratings": "^2.3.3",
    "axios": "^1.19.0",
    "dompurify": "^3.4.13",
    "jsonwebtoken": "^9.0.3",
    "path-browserify": "^1.0.1",
    "query-string": "^9.5.0",
    "react": "19.2.8",
    "react-datepicker": "^9.1.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-ga4": "^3.0.1",
    "react-global-configuration": "^1.4.2",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "react-youtube": "^10.1.0",
    "webpack": "^5.109.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/react-global-configuration": "^1.3.3",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "^5.0.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "typescript": "^6.0.3",
    "url": "^0.11.4",
    "vm-browserify": "^1.1.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "ajv": "^8",
    "fork-ts-checker-webpack-plugin": {
      "ajv": "^6"
    },
    "babel-loader": {
      "ajv": "^6"
    },
    "file-loader": {
      "ajv": "^6"
    },
    "eslint": {
      "ajv": "^6",
      "@eslint/eslintrc": {
        "ajv": "^6.12.4"
      }
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
    }
